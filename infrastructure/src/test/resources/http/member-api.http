    "mobileNumber": "010-1234-5678",
    "landlineNumber": "02-9876-5432",
    "registrationDate": "2025-11-03",
    "isSmsSendingAllowed": true,
    "memo": "신규 우수 고객 등록"
  },
  "paymentMethod": {
    "paymentMethodType": "CMS",
    "cms": {
      "bankName": "국민은행",
      "accountNumber": "1234567890123",
      "accountHolderName": "홍길동",
      "accountHolderType": "개인",
      "dateOfBirth": "19901020",
      "businessRegistrationNumber": null,
      "consentInformation": "동의 완료 (2025-11-03)"
    },
    "rcms": null,
    "card": null,
    "mobile": null,
