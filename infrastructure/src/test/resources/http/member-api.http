  },
  "proof": {
    "proofType": "세금계산서",
    "cashReceipt": null,
    "taxInvoice": {
      "memberType": "BUSINESS",
      "taxType": "과세",
      "registrationNumber": "123-45-67890",
      "tradeName": "주식회사 ABC솔루션",
      "representativeName": "김철수",
      "itemName": "IT 서비스 이용료",
      "issuanceType": "EMAIL",
      "issuanceMethod": "자동 발행"
    }
  }
}

### 사용자 정보 조회 API
GET {{host}}/api/v1/members
Content-Type: application/json